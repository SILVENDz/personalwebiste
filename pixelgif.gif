  100% { transform: translateX(0px); }
}

@keyframes slide-out-ltr_1s {=20
  0% { transform: translateX(0px); }
  100% { transform: translateX(100%); }
}

@keyframes slide-out-rtl_1s {=20
  0% { transform: translateX(0px); }
  100% { transform: translateX(-100%); }
}

